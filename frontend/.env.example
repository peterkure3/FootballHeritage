# API Configuration
# Backend API URL (update with your backend URL)
VITE_API_URL=http://localhost:8888/api/v1

# Pipeline calls use the authenticated Rust gateway at VITE_API_URL + /pipeline.
# Do not expose a separate FastAPI URL or private credentials to the browser.

# Environment
VITE_ENV=development

# Session timeout (in minutes)
VITE_SESSION_TIMEOUT=15

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_PREDICTIONS=true
