# Reference only. Never commit a populated environment file.
# Backend runtime (Vercel): scoped app role, pooled endpoint; migration role separate.
APP_ENV=production
RUN_MIGRATIONS=false
DATABASE_URL=postgresql://fh_api:REPLACE@ep-REPLACE-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://fh_migrations:REPLACE@ep-REPLACE.REGION.aws.neon.tech/neondb?sslmode=verify-full
DB_MAX_CONNECTIONS=3
HTTP_WORKERS=1
PUBLICATION_STREAM_ID=REPLACE_WITH_REGISTERED_SOURCE_UUID
ALLOWED_ORIGINS=https://REPLACE.vercel.app
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_32_BYTE_KEY
HTTPS_ENABLED=false
HOST=0.0.0.0

# Frontend only: public Rust origin; never place DB URLs in VITE_* variables.
VITE_API_URL=https://REPLACE-API.vercel.app/api/v1

# Windows publication worker only. Put these in a private pipeline/.env.sync.
SYNC_LOCAL_DATABASE_URL=postgresql://fh_local_publisher:REPLACE@127.0.0.1:5432/football_betting
SYNC_NEON_DATABASE_URL=postgresql://fh_sync_worker:REPLACE@ep-REPLACE.REGION.aws.neon.tech/neondb?sslmode=verify-full
SYNC_MODEL_VERSION=2.0.0
# Set PGSSLROOTCERT to a trusted CA bundle path when libpq needs it on Windows.
# No production-to-Windows URL, inbound port or public FastAPI service is needed.
# Existing backend gateway token settings remain required until API migration is complete.
