
# Application Environment
APP_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/football_heritage

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here-min-256-bits
JWT_EXPIRATION_HOURS=24

# Encryption Configuration
ENCRYPTION_KEY=your-256-bit-encryption-key-for-wallet-balances-here

# Server Configuration
HOST=127.0.0.1
PORT=8888
PIPELINE_API_URL=http://127.0.0.1:5555/api/v1
# Rust RAG chat reads predictions directly from a read-only connection.
RAG_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/football_betting
RAG_MODEL_VERSION=2.0.0
RAG_GEMINI_API_KEY=your_gemini_api_key_here
RAG_GEMINI_MODEL=gemini-2.5-flash
# auto generates replies when available; grounded returns retrieved evidence directly.
RAG_CHAT_MODE=auto
HTTPS_ENABLED=true

# TLS/SSL Configuration
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key

# Rate Limiting Configuration
BET_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_HOUR=5

# Security Configuration
BCRYPT_COST=12
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Responsible Gambling Defaults
DEFAULT_DAILY_LOSS_LIMIT=1000.00
DEFAULT_WEEKLY_LOSS_LIMIT=5000.00
DEFAULT_MONTHLY_LOSS_LIMIT=15000.00
DEFAULT_DAILY_BET_LIMIT=2000.00
DEFAULT_WEEKLY_BET_LIMIT=10000.00
DEFAULT_MONTHLY_BET_LIMIT=30000.00
DEFAULT_MAX_SINGLE_BET=500.00

# Logging Configuration
LOG_LEVEL=info
FRAUD_ALERT_EMAIL=security@footballheritage.com

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Monitoring Configuration
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30
