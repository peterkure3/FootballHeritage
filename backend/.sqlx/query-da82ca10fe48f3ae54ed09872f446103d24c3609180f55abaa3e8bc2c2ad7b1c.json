  "query": "\n        SELECT \n            l.id, l.action, l.target_type, l.target_id, l.created_at,\n            u.email as admin_email\n        FROM admin_logs l\n        JOIN users u ON l.admin_id = u.id\n        ORDER BY l.created_at DESC\n        LIMIT 100\n        ",
