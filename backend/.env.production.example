APP_ENV=production
HOST=0.0.0.0
PORT=8888
# TLS terminates at the trusted hosting ingress; never expose the plain port.
HTTPS_ENABLED=false
DATABASE_URL=postgresql://app:REPLACE_ME@database.example:5432/football_heritage?sslmode=require
DB_MAX_CONNECTIONS=10
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_32_BYTES_KEY
ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com
PIPELINE_API_URL=http://pipeline.internal:5555/api/v1
PIPELINE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
RAG_DATABASE_URL=postgresql://readonly:REPLACE_ME@database.example:5432/football_betting?sslmode=require
RAG_CHAT_MODE=grounded
RAG_GEMINI_API_KEY=
RAG_GEMINI_MODEL=gemini-2.5-flash
CHATBOT_SERVICE_URL=http://chatbot.internal:3000/chat
# Demo wallet funding stays blocked in production. This is not a payment gateway.
ALLOW_DEMO_WALLET_FUNDING=false
RUST_LOG=info
METRICS_ENABLED=true

# Run /app/migrate separately with this secret; do not pass it to the API.
# MIGRATION_DATABASE_URL=postgresql://migration_owner:REPLACE_ME@database.example:5432/football_heritage?sslmode=require
RUN_MIGRATIONS=false
CHATBOT_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
